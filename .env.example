# Copy to .env and fill in. The real file is gitignored and is the only place
# a secret belongs in this project - do not pass either of the two values
# below on the command line, where they land in shell history.
#
# Only SONIOX_API_KEY is actually required. Everything else has a default.

# --- secrets ---------------------------------------------------------------

# Your Soniox API key. Get one at https://soniox.com - sign in, then Account
# -> API keys -> create. Required for a live session; replaying a saved
# capture does not touch the network and needs no key.
SONIOX_API_KEY=

# Token guarding /admin. Leave it blank and the server generates one on first
# run, writes it here, and prints it once with the URL to open. Set it
# yourself if you would rather choose: a long random string, nothing
# memorable. Delete the line to be issued a new one on the next start.
ADMIN_TOKEN=

# --- engine ----------------------------------------------------------------

# Which real-time speech model to stream to. Leave it blank for the model
# this project has measured, which is what /admin shows. The only other
# accepted value is the older stt-rt-v5, kept selectable so a bad evening can
# be answered by going back rather than by editing code. Anything else and
# the server refuses to start, which is better than finding out at Start.
SONIOX_MODEL=

# --- spend -----------------------------------------------------------------

# Dollars per streamed minute, used only to show spend on /admin. Nothing
# here bills you; it is a counter, and the number comes from your own plan.
#
# The default below works out to roughly $0.20 per hour of live audio with
# two-way translation running, which is what this project measured. Soniox
# prices audio and text tokens separately, so your figure moves with how much
# is actually said - check soniox.com/pricing against your own invoice.
SONIOX_RATE_PER_MINUTE=0.0033

# A ceiling, in dollars, shown on /admin beside what has been spent. It is a
# display value and a reminder, not an enforced cap.
SONIOX_BUDGET_USD=10

# --- the screen ------------------------------------------------------------

# A default for the title card's credit line - "captions by ...". Used only
# on a fresh install where config/screen.yaml has nothing saved yet; once
# /admin has written that file, this is ignored.
#
# Branding is not configured here. It lives in config/brand.json and the
# brand/ folder - see config/brand.example.json.
SCREEN_CREDIT=
